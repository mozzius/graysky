{
  "name": "@graysky/prettier-config",
  "version": "0.1.0",
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "devDependencies": {
    "@graysky/tsconfig": "0.1.0",
    "typescript": "^6.0.3"
  },
  "main": "index.mjs",
  "prettier": "./index.mjs",
  "private": true,
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check \"**/*.{mjs,json}\"",
    "format:fix": "prettier --write \"**/*.{mjs,json}\"",
    "typecheck": "tsc --noEmit"
  }
}
