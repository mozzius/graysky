    "@graysky/tailwind-config": "0.1.0",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.22.1",
    "@trpc/next": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "bright": "^1.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-mdx-remote": "^6.0.0",
