{
  "name": "@graysky/app",
  "version": "3.0.0",
  "main": "index.tsx",
  "scripts": {
    "eas-build-pre-install": "./scripts/pre-install.sh",
    "build:ios": "./scripts/build-ios.sh",
    "build:android": "./scripts/build-android.sh",
    "build:dev-client:ios": "eas build --platform ios --profile development",
    "build:dev-client:ios-simulator": "./scripts/build-ios-devclient.sh",
    "build:dev-client:android": "./scripts/build-android-devclient.sh",
    "prebuild": "DEV_CLIENT=true EXPO_NO_GIT_STATUS=1 expo prebuild --clean",
    "start": "expo start",
    "aab-to-apk": "./scripts/aab-to-apk.sh",
    "clean": "git clean -xdf .expo .turbo node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,md,json}\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "DEV_CLIENT=true expo run:ios",
    "zip-extension": "cd OpenInGrayskyExtension && zip -r ../OpenInGrayskyExtension.zip . -x '**/.DS_Store'",
    "extract": "lingui extract",
    "compile": "lingui compile",
    "postinstall": "lingui extract && lingui compile"
