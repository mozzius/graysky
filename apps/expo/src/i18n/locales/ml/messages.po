msgstr "മോഡറേഷൻ ലിസ്‌റ്റ് വഴി നിങ്ങൾ ബ്ലോക്ക് ചെയ്‌തതോ മ്യുട്ടാക്കിയതോ ആയ ആളുകളിൽ നിന്ന് നിങ്ങൾക്ക് അറിയിപ്പുകൾ ലഭിച്ചേക്കാം. <0>കൂടുതലറിയുക</0>"

#: src/app/push-notifications.tsx:52
msgid "You might receive the same notifications via other Bluesky clients."
msgstr "മറ്റ് ബ്ലൂസ്കൈ ക്ലയൻ്റുകൾ വഴിയും നിങ്ങൾക്ക് ഇതേ അറിയിപ്പുകൾ ലഭിച്ചേക്കാം."

#: src/app/(auth)/sign-in.tsx:140
#~ msgid "You might want to use an App Password rather than your main password - this helps keep your account secure, but it's not required."
#~ msgstr "നിങ്ങളുടെ പ്രധാന പാസ്‌വേഡിനേക്കാൾ ഒരു ആപ്പ് പാസ്‌വേഡ് ഉപയോഗിക്കുന്നത് നല്ലതാണ് - ഇത് നിങ്ങളുടെ അക്കൗണ്ട് സുരക്ഷിതമായി നിലനിർത്താൻ സഹായിക്കുന്നു, എന്നാൽ ഇത് നിർബന്ധമല്ല."

