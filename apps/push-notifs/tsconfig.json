{
  "extends": "@graysky/tsconfig/base.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"]
    },
    // This service is bundled with esbuild, and @bsky/jetstream and
    // @atproto/lex only expose types via "exports", which the base
    // config's "node" resolution can't read.
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json"
  },
  "include": ["*.ts", "*.js", "src"],
  "exclude": ["node_modules"]
}
